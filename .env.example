# ───────────────────────────── QQ 官方机器人 ─────────────────────────────
# 在 https://q.qq.com 机器人管理端获取。AppSecret 只放 .env.local，不要提交。
QQ_APP_ID=
QQ_APP_SECRET=
# 网关/接口基址（默认官方地址；测试时指向本地假 QQ 服务器）
QQ_API_BASE=https://api.bot.qq.com
QQ_TOKEN_URL=https://api.bot.qq.com/app/getAppAccessToken
# 群@ + 单聊事件：GROUP_AND_C2C_EVENT = 1 << 25
QQ_INTENTS=33554432

# ──────────────────────────── RankHub Open API ────────────────────────────
# 在 open.rankhub.cc 注册的 OAuth 应用（机密客户端，client_secret_post）
RANKHUB_CLIENT_ID=rankhub-qqbot
RANKHUB_CLIENT_SECRET=
RANKHUB_AUTH_BASE=https://auth.rankhub.cc
RANKHUB_API_BASE=https://api.rankhub.cc
# v1 只读：不申请 game:write
RANKHUB_SCOPES=openid profile offline_access game:read
# 授权码回调（建议绑定 App 扫码方向时无需访问；仅作为 code 载体，需在应用上注册）
RANKHUB_REDIRECT_URI=http://127.0.0.1:17830/callback
# 设备码轮询上限（秒），必须留足 QQ 被动回复 5 分钟窗口
RANKHUB_DEVICE_POLL_MAX_SECONDS=240

# ──────────────────────────────── 存储/安全 ────────────────────────────────
# 32 字节 base64；用于 AES-256-GCM 加密 refresh/access token
TOKEN_ENC_KEY=
DB_PATH=./data/bot.db

# ───────────────────────────────── 渲染 ─────────────────────────────────
# Playwright Chromium 可执行文件（留空则用 playwright-core 默认解析；本机可指向缓存里的 chrome-headless-shell）
RENDER_BROWSER_PATH=
# maimaiDX 资源包路径（留空则用 ./vendor/mai）
MAIMAIDX_STATIC=
# phi-plugin 资源目录（留空则用 ./vendor/phi）
PHI_PLUGIN_RES=
# maimai 渲染模式：auto=先移植，不可用时降级；node=仅移植；python=仅 sidecar
MAIMAI_RENDERER=auto
MAIMAI_PYTHON=python3.11

# ───────────────────────────────── 运行 ─────────────────────────────────
LOG_LEVEL=info
# 本地假服务器联调用；生产留空
QQ_FAKE_BASE=
