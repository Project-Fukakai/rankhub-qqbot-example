{
  "name": "rankhub-qqbot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "RankHub QQ 查分机器人（QQ 官方 API v2 + RankHub Open API）",
  "license": "GPL-3.0-or-later",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run test/unit",
    "test:e2e": "vitest run test/e2e",
    "test:render": "vitest run test/render",
    "assets:fetch": "node scripts/fetch-assets-phi.mjs && node scripts/fetch-assets-mai.mjs",
    "assets:phi": "node scripts/fetch-assets-phi.mjs",
    "assets:mai": "node scripts/fetch-assets-mai.mjs",
    "assets:verify": "node scripts/verify-assets.mjs",
    "live:whoami": "tsx scripts/live-whoami.ts",
    "live:gateway": "tsx scripts/live-gateway.ts"
  },
  "dependencies": {
    "@napi-rs/canvas": "^0.1.80",
    "art-template": "^4.13.2",
    "playwright-core": "^1.64.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
